# Copy to .env and fill in. Never commit .env.
WT_ENV=development

# SQLAlchemy URL for your MySQL 8 instance (database must exist, utf8mb4).
#   CREATE DATABASE winetracker CHARACTER SET utf8mb4 COLLATE utf8mb4_0900_ai_ci;
WT_DATABASE_URL=mysql+pymysql://winetracker:CHANGE_ME@localhost:3306/winetracker?charset=utf8mb4

# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
WT_JWT_SECRET=CHANGE_ME

WT_WEB_SESSION_SECRET=CHANGE_ME

# Where the Dash UI reaches the API.
WT_API_BASE_URL=http://127.0.0.1:8000
WT_CORS_ORIGINS=["http://127.0.0.1:8052","http://localhost:8052"]
